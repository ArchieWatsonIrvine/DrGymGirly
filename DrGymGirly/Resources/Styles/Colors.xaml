<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Warm/energetic brand palette (coral / amber), replacing the earlier
         green/gold scheme. Neutrals below are warm-biased (a touch of
         brown/tan rather than true gray) so pages don't fall back to a cool,
         clinical look wherever a Gray* token is used instead of a semantic one. -->
    <Color x:Key="Primary">#FF5833</Color>
    <Color x:Key="PrimaryDark">#FF6B47</Color>
    <Color x:Key="PrimaryDarkText">#1C130D</Color>
    <Color x:Key="Secondary">#FFE3D6</Color>
    <Color x:Key="SecondaryDark">#3A2418</Color>
    <Color x:Key="SecondaryDarkText">#F5E9DD</Color>
    <Color x:Key="Tertiary">#FFB238</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gold">#FFB238</Color>
    <!-- Dark-mode card/row/swipe-item surface (distinct from the page-level
         PageCanvas* tokens below) so cards still read as "raised" in dark mode. -->
    <Color x:Key="OffBlack">#271B13</Color>

    <!-- Page/Shell background only - NOT used for card surfaces, which stay
         White/OffBlack so cards visually separate from the page canvas. -->
    <Color x:Key="PageCanvasLight">#FFF7F0</Color>
    <Color x:Key="PageCanvasDark">#1C130D</Color>

    <Color x:Key="Gray100">#F3E4D4</Color>
    <Color x:Key="Gray200">#EAD9C4</Color>
    <Color x:Key="Gray300">#D9C2A6</Color>
    <Color x:Key="Gray400">#BBA794</Color>
    <Color x:Key="Gray500">#8C7A6B</Color>
    <Color x:Key="Gray600">#5C4A3D</Color>
    <Color x:Key="Gray900">#2A1F18</Color>
    <Color x:Key="Gray950">#1C130D</Color>

    <!-- Semantic tokens used across pages so status colors stay consistent
         instead of each page hardcoding its own shade of green/red/pink. -->
    <Color x:Key="Success">#7A9A4A</Color>
    <Color x:Key="Danger">#D4303F</Color>
    <!-- Darker than Gold/Tertiary so bold highlight text stays readable on white. -->
    <Color x:Key="Accent">#C1551B</Color>

    <!-- Per-meal colors for the Nutrition page's meal legend dots and the
         stacked progress bars (distinct from Gold/Danger used for swipe actions).
         Chosen so no two meals share a hue family (Lunch/Dinner used to both
         be shades of green). -->
    <Color x:Key="MealBreakfast">#F2A93B</Color>
    <Color x:Key="MealLunch">#D9683A</Color>
    <Color x:Key="MealDinner">#A8442E</Color>
    <Color x:Key="MealSnacks">#3E8E8A</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>