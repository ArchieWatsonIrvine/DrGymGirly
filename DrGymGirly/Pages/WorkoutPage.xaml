<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DrGymGirly.WorkoutPage"
             Title="Workouts">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding SelectedDateHeading}" Style="{StaticResource PageTitle}" />
                <DatePicker Grid.Column="1" x:Name="JumpDatePicker" DateSelected="OnJumpDateSelected" Format="d MMM" FontSize="13" VerticalOptions="Center" />
            </Grid>

            <!-- Calendar -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                    <Label Text="Mo" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="1" Text="Tu" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="2" Text="We" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="3" Text="Th" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="4" Text="Fr" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="5" Text="Sa" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                    <Label Grid.Column="6" Text="Su" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding CalendarDays}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid HeightRequest="48">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalendarDayTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 16"
                                        HeightRequest="32"
                                        WidthRequest="32"
                                        Padding="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid>
                                        <Label Text="{Binding DayNumber}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <BoxView IsVisible="{Binding HasLogged}"
                                                 Color="{StaticResource Success}"
                                                 HeightRequest="4"
                                                 WidthRequest="4"
                                                 CornerRadius="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="End"
                                                 Margin="0,0,0,2" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding DayTypeAbbrev}"
                                       TextColor="{Binding DayTypeColor}"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Margin="0,4,0,0" />

            <Label Text="{Binding DayTypeHeading}" FontAttributes="Bold" FontSize="18" />
            <HorizontalStackLayout Spacing="6">
                <Button Text="Library" Clicked="OnManageLibraryClicked" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" />
                <Button Text="Edit Day" Clicked="OnEditDayTypeExercisesClicked" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" />
                <Button Text="Swap Day" Clicked="OnSwapDayClicked" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" />
                <Button Text="Schedule" Clicked="OnEditScheduleClicked" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="10,4" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Exercises}">
                <CollectionView.EmptyView>
                    <Label Text="Rest day — nothing scheduled." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                          <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="12" Color="{Binding DayTypeColor}" />
                            <VerticalStackLayout Spacing="6" Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExerciseTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding ExerciseName}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding TargetsDisplay}" Style="{StaticResource AccentLabel}" FontSize="12" />
                                        <Label Text="{Binding PreviousPerformance}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                        <Label Text="{Binding LoggedTodayText}" TextColor="{StaticResource Success}" FontSize="11" IsVisible="{Binding LoggedToday}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="{Binding CompleteButtonText}"
                                            Clicked="OnToggleCompleteClicked"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource TintedPillButton}"
                                            VerticalOptions="Start">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <Entry Placeholder="Reps" Text="{Binding CurrentReps}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                                    <Entry Grid.Column="1" Placeholder="Weight (kg)" Text="{Binding CurrentWeight}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                                    <Button Grid.Column="2" Text="Log" Clicked="OnLogSetClicked" CommandParameter="{Binding .}" Padding="12,0" />
                                </Grid>
                            </VerticalStackLayout>
                          </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Cardio -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Cardio" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddCardioClicked" FontSize="10" Padding="10,4" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding CardioLogs}">
                        <CollectionView.EmptyView>
                            <Label Text="No cardio logged yet." Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,4" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.LeftItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Remove" BackgroundColor="{StaticResource Danger}" Invoked="OnRemoveCardioInvoked" CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>
                                    <VerticalStackLayout BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                                        <Label Text="{Binding DisplayText}" FontSize="13" Padding="0,6" />
                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                    </VerticalStackLayout>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
