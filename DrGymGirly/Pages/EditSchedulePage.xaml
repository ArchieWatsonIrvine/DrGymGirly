<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DrGymGirly.EditSchedulePage"
             Title="Weekly Schedule">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Weekly Schedule" Style="{StaticResource PageTitle}" />
            <Label Text="Assign one or more default workouts (or Rest) to each day of the week." Style="{StaticResource MutedLabel}" Margin="0,0,0,8" />

            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Monday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="MondayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Tuesday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="TuesdayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Wednesday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="WednesdayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Thursday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="ThursdayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Friday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="FridayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Saturday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="SaturdayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="Sunday" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="SundayButton" Text="Rest" Clicked="OnDayClicked" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="10,4" HorizontalOptions="End" />
            </Grid>

            <Button Text="Save" Clicked="OnSaveClicked" FontAttributes="Bold" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
