<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DrGymGirly.BodyWeightPage"
             Title="Body Weight">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="Body Weight" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding BaselineSummary}" Style="{StaticResource AccentLabel}" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding HasBaselineSummary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Log Weight" Clicked="OnLogWeightClicked" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8" IsVisible="{Binding HasChartData}">
            <GraphicsView x:Name="WeightChart" HeightRequest="200" />
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Records}">
            <CollectionView.EmptyView>
                <Label Text="No weight logged yet." HorizontalOptions="Center" Margin="0,40" Style="{StaticResource MutedLabel}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding LogDate, StringFormat='{0:dddd, d MMMM yyyy}'}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding DifferenceText}" TextColor="{Binding DifferenceColor}" FontAttributes="Bold" FontSize="15" HorizontalOptions="End" />
                                <Label Text="{Binding WeightAchieved, StringFormat='{0:N1} kg'}" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
